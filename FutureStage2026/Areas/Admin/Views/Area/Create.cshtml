@model Area

@{
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="card shadow-sm border-0">

    <div class="card-header bg-white">
        <div class="d-flex justify-content-between align-items-center">

            <div>
                <h3 class="mb-0 fw-bold">
                    Add Area
                </h3>

                <small class="text-muted">
                    Create a new area for a city
                </small>
            </div>

            <a asp-action="Index"
               class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i>
                Back to List
            </a>

        </div>
    </div>

    <div class="card-body">

        <form method="post">

            <div class="row">

                <div class="col-md-6">

                    <div class="mb-3">

                        <label asp-for="AreaName" class="form-label fw-semibold">
                            Area Name
                        </label>

                        <input asp-for="AreaName"
                               class="form-control"
                               placeholder="Enter Area Name" />

                        <span asp-validation-for="AreaName"
                              class="text-danger">
                        </span>

                    </div>

                </div>

                <div class="col-md-6">

                    <div class="mb-3">

                        <label asp-for="CityId" class="form-label fw-semibold">
                            City
                        </label>

                        <select asp-for="CityId"
                                asp-items="ViewBag.Cities"
                                class="form-select">

                            <option value="">
                                -- Select City --
                            </option>

                        </select>

                        <span asp-validation-for="CityId"
                              class="text-danger">
                        </span>

                    </div>

                </div>

            </div>

            <hr />

            <div class="d-flex gap-2">

                <button type="submit"
                        class="btn btn-success">

                    <i class="bi bi-check-circle me-1"></i>
                    Save Area

                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">

                    <i class="bi bi-x-circle me-1"></i>
                    Cancel

                </a>

            </div>

        </form>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}