@model Area


@{
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<h3 class="text-danger">⚠️ Are you sure you want to delete this Area?</h3>

<div class="card mt-3">
    <div class="card-body">

        <p><strong>Area:</strong> @Model.AreaName</p>
        <p><strong>City:</strong> @Model.City?.CityName</p>
        <p><strong>State:</strong> @Model.City?.State?.StateName</p>
        <p><strong>Country:</strong> @Model.City?.State?.Country?.CountryName</p>

    </div>
</div>

<form method="post" class="mt-3">

    <input type="hidden" asp-for="Id" />

    <button type="submit" class="btn btn-danger">Delete</button>

    <a 
       asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>

</form>