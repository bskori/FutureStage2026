@model List<Area>

@{
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="card shadow-sm border-0">

    <div class="card-header bg-white">
        <div class="d-flex justify-content-between align-items-center">

            <div>
                <h3 class="mb-0 fw-bold">
                    Areas
                </h3>

                <small class="text-muted">
                    Manage all areas in the system
                </small>
            </div>

            <a asp-action="Create"
               class="btn btn-primary">
                <i class="bi bi-plus-circle me-1"></i>
                Add Area
            </a>

        </div>
    </div>

    <div class="card-body">

        <div class="mb-3">
            <span class="badge bg-primary">
                Total Areas : @Model.Count
            </span>
        </div>

        @if (Model.Any())
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>Area</th>
                            <th>City</th>
                            <th>State</th>
                            <th>Country</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @{
                            int sr = 1;
                        }

                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>
                                    @sr
                                </td>

                                <td>
                                    <strong>@item.AreaName</strong>
                                </td>

                                <td>
                                    @item.City?.CityName
                                </td>

                                <td>
                                    @item.City?.State?.StateName
                                </td>

                                <td>
                                    @item.City?.State?.Country?.CountryName
                                </td>

                                <td class="text-center">

                                    <a asp-action="Edit"
                                       asp-route-id="@item.Id"
                                       class="btn btn-sm btn-warning me-1">

                                        <i class="bi bi-pencil-square"></i>
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@item.Id"
                                       class="btn btn-sm btn-danger">

                                        <i class="bi bi-trash"></i>
                                    </a>

                                </td>

                            </tr>

                            sr++;
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="text-center py-5">

                <i class="bi bi-folder-x display-3 text-secondary"></i>

                <h5 class="mt-3">
                    No Areas Found
                </h5>

                <p class="text-muted">
                    Click the button above to create your first area.
                </p>

            </div>
        }

    </div>

</div>