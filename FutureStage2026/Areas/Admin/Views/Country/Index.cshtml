@model List<Country>

@{
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}


<h2>Countries</h2>

<a asp-action="Create" class="btn btn-success mb-2">Add Country</a>

<table class="table table-bordered">
    <tr>
        <th>ID</th>
        <th>Name</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Id</td>
            <td>@item.CountryName</td>
            <td>
                <a asp-action="Edit" class="btn btn-primary me-1" asp-route-id="@item.Id">Edit</a>
                <a asp-action="Delete" class="btn btn-danger" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
    }
</table>