@model FutureStage2026.Models.EducationBoard

<h2>Add Education Board</h2>

<form asp-action="Create" method="post">

    <div class="mb-3">
        <label class="form-label">Board Title</label>
        <input asp-for="EducationBoardTitle" class="form-control" />
        <span asp-validation-for="EducationBoardTitle" class="text-danger"></span>
    </div>

    <button class="btn btn-success">Save</button>
    <a asp-action="Index" class="btn btn-secondary">Back</a>

</form>