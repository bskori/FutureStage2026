@model IEnumerable<Facility>

<h2>Facilities</h2>

<a asp-action="Create" class="btn btn-success mb-3">Add Facility</a>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Title</th>
            <th>Description</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var f in Model)
        {
            <tr>
                <td>@f.FacilityTitle</td>
                <td>@f.FacilityDesc</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@f.Id" class="btn btn-warning btn-sm">Edit</a>
                    <a asp-action="Details" asp-route-id="@f.Id" class="btn btn-info btn-sm">View</a>
                    <a asp-action="Delete" asp-route-id="@f.Id"
                       class="btn btn-danger btn-sm"
                       onclick="return confirm('Are you sure?')">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>