@model IEnumerable<Medium>

@{
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="card shadow-sm border-0">

    <div class="card-header bg-white">

        <div class="d-flex justify-content-between align-items-center">

            <div>
                <h3 class="mb-0 fw-bold">
                    Mediums
                </h3>

                <small class="text-muted">
                    Manage all education mediums
                </small>
            </div>

            <a asp-action="Create"
               class="btn btn-primary">

                <i class="bi bi-plus-circle me-1"></i>
                Add Medium

            </a>

        </div>

    </div>

    <div class="card-body">

        <span class="badge bg-primary mb-3">
            Total Mediums : @Model.Count()
        </span>

        @if (Model.Any())
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead class="table-light">

                        <tr>
                            <th>#</th>
                            <th>Medium Title</th>
                            <th class="text-center">Actions</th>
                        </tr>

                    </thead>

                    <tbody>

                        @{
                            int sr = 1;
                        }

                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>@sr</td>

                                <td>
                                    <strong>@item.MediumTitle</strong>
                                </td>

                                <td class="text-center">

                                    <a asp-action="Edit"
                                       asp-route-id="@item.Id"
                                       class="btn btn-warning btn-sm me-1">

                                        <i class="bi bi-pencil-square"></i>

                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@item.Id"
                                       class="btn btn-danger btn-sm">

                                        <i class="bi bi-trash"></i>

                                    </a>

                                </td>

                            </tr>

                            sr++;
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="text-center py-5">

                <i class="bi bi-translate display-3 text-secondary"></i>

                <h5 class="mt-3">
                    No Mediums Found
                </h5>

                <p class="text-muted">
                    Click Add Medium to create your first medium.
                </p>

            </div>
        }

    </div>

</div>