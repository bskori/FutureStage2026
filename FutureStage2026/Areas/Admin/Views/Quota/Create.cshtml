@model FutureStage2026.Models.Quota

<h2>Add Quota</h2>

<form asp-action="Create" method="post">

    <div class="mb-3">
        <label>Quota Title</label>
        <input asp-for="QuotaTitle" class="form-control" />
        <span asp-validation-for="QuotaTitle" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label>Description</label>
        <textarea asp-for="QuotaDesc" class="form-control"></textarea>
    </div>

    <button class="btn btn-success">Save</button>
    <a asp-action="Index" class="btn btn-secondary">Back</a>

</form>