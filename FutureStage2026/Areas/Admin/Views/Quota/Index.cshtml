@model IEnumerable<Quota>

@{
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="card shadow-sm border-0">

    <div class="card-header bg-white">

        <div class="d-flex justify-content-between align-items-center">

            <div>
                <h3 class="mb-0 fw-bold">
                    Quotas
                </h3>

                <small class="text-muted">
                    Manage all admission quotas
                </small>
            </div>

            <a asp-action="Create"
               class="btn btn-primary">

                <i class="bi bi-plus-circle me-1"></i>
                Add Quota

            </a>

        </div>

    </div>

    <div class="card-body">

        <div class="mb-3">

            <span class="badge bg-primary">
                Total Quotas : @Model.Count()
            </span>

        </div>

        @if (Model.Any())
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead class="table-light">

                        <tr>
                            <th>#</th>
                            <th>Quota Title</th>
                            <th>Description</th>
                            <th class="text-center">Actions</th>
                        </tr>

                    </thead>

                    <tbody>

                        @{
                            int sr = 1;
                        }

                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>@sr</td>

                                <td>
                                    <strong>@item.QuotaTitle</strong>
                                </td>

                                <td>

                                    @if (!string.IsNullOrWhiteSpace(item.QuotaDesc))
                                    {
                                        @(item.QuotaDesc.Length > 60
                                            ? item.QuotaDesc.Substring(0, 60) + "..."
                                            : item.QuotaDesc)
                                    }
                                    else
                                    {
                                        <span class="text-muted">N/A</span>
                                    }

                                </td>

                                <td class="text-center">

                                    <a asp-action="Edit"
                                       asp-route-id="@item.Id"
                                       class="btn btn-warning btn-sm me-1">

                                        <i class="bi bi-pencil-square"></i>

                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@item.Id"
                                       class="btn btn-danger btn-sm">

                                        <i class="bi bi-trash"></i>

                                    </a>

                                </td>

                            </tr>

                            sr++;
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="text-center py-5">

                <i class="bi bi-card-checklist display-3 text-secondary"></i>

                <h5 class="mt-3">
                    No Quotas Found
                </h5>

                <p class="text-muted">
                    Click Add Quota to create your first quota.
                </p>

            </div>
        }

    </div>

</div>