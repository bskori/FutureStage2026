@model FutureStage2026.Models.State

@{
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<h3>Are you sure you want to delete this State?</h3>

<div class="card mt-3">
    <div class="card-body">

        <p><strong>State Name:</strong> @Model.StateName</p>
        <p><strong>Country:</strong> @Model.Country?.CountryName</p>

    </div>
</div>

<form  method="post" class="mt-3">

    <input type="hidden" asp-for="Id" />

    <button type="submit" class="btn btn-danger">Delete</button>

    <a asp-area="Admin"
       asp-controller="State"
       asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>

</form>