@model FutureStage2026.Models.AdmissionPrerequisite

<div class="card shadow-sm border-0">

    <div class="card-header bg-white">

        <h3 class="mb-0 fw-bold">
            Edit Admission Prerequisite
        </h3>

    </div>

    <div class="card-body">

        <form method="post">

            <input asp-for="Id" type="hidden" />

            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger">
            </div>

            <div class="mb-3">

                <label asp-for="PrerequisiteTitle"
                       class="form-label fw-semibold">
                </label>

                <input asp-for="PrerequisiteTitle"
                       class="form-control" />

                <span asp-validation-for="PrerequisiteTitle"
                      class="text-danger">
                </span>

            </div>

            <div class="mb-3">

                <label asp-for="SchoolStandardId"
                       class="form-label fw-semibold">
                    School Standard
                </label>

                <select asp-for="SchoolStandardId"
                        asp-items="ViewBag.SchoolStandards"
                        class="form-select">

                    <option value="">
                        -- Select School Standard --
                    </option>

                </select>

            </div>

            <div class="mb-3">

                <label asp-for="PrerequisiteDesc"
                       class="form-label fw-semibold">
                </label>

                <textarea asp-for="PrerequisiteDesc"
                          rows="4"
                          class="form-control"></textarea>

            </div>

            <hr />

            <button class="btn btn-warning">

                <i class="bi bi-pencil-square me-1"></i>
                Update

            </button>

            <a asp-action="Index"
               class="btn btn-secondary">

                Cancel

            </a>

        </form>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}