@model FutureStage2026.Models.AdmissionProcess

<div class="card shadow-sm border-0">

    <div class="card-header bg-white">

        <h3 class="mb-0 fw-bold">
            Add Admission Process
        </h3>

    </div>

    <div class="card-body">

        <form method="post">

            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger">
            </div>

            <div class="mb-3">

                <label asp-for="ProcessTitle"
                       class="form-label fw-semibold">
                </label>

                <input asp-for="ProcessTitle"
                       class="form-control" />

                <span asp-validation-for="ProcessTitle"
                      class="text-danger">
                </span>

            </div>

            <div class="mb-3">

                <label asp-for="SchoolStandardId"
                       class="form-label fw-semibold">
                    School Standard
                </label>

                <select asp-for="SchoolStandardId"
                        asp-items="ViewBag.SchoolStandards"
                        class="form-select">

                    <option value="">
                        -- Select School Standard --
                    </option>

                </select>

                <span asp-validation-for="SchoolStandardId"
                      class="text-danger">
                </span>

            </div>

            <div class="mb-3">

                <label asp-for="ProcessDesc"
                       class="form-label fw-semibold">
                </label>

                <textarea asp-for="ProcessDesc"
                          rows="4"
                          class="form-control"></textarea>

            </div>

            <hr />

            <button type="submit"
                    class="btn btn-success">

                <i class="bi bi-check-circle me-1"></i>
                Save

            </button>

            <a asp-action="Index"
               class="btn btn-secondary">

                Cancel

            </a>

        </form>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}