@model IEnumerable<FutureStage2026.Models.AdmissionProcess>

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h3 class="fw-bold mb-1">Admission Process</h3>
        <p class="text-muted mb-0">
            Manage admission process steps for standards
        </p>
    </div>

    <a asp-action="Create" class="btn btn-success">
        <i class="bi bi-plus-circle me-1"></i>
        Add Process
    </a>

</div>

<div class="card shadow-sm border-0">

    <div class="card-body">

        <div class="table-responsive">

            <table class="table table-hover align-middle">

                <thead class="table-light">

                    <tr>
                        <th>#</th>
                        <th>Process Title</th>
                        <th>Description</th>
                        <th>School Standard</th>
                        <th width="180">Actions</th>
                    </tr>

                </thead>

                <tbody>

                    @{
                        int sr = 1;
                    }

                    @foreach (var item in Model)
                    {
                        <tr>

                            <td>@sr</td>

                            <td>
                                <strong>@item.ProcessTitle</strong>
                            </td>

                            <td>
                                @(string.IsNullOrWhiteSpace(item.ProcessDesc)
                                    ? "N/A"
                                    : item.ProcessDesc)
                            </td>

                            <td>
                                @item.SchoolStandardId
                            </td>

                            <td>

                                <a asp-action="Edit"
                                   asp-route-id="@item.Id"
                                   class="btn btn-warning btn-sm me-1">

                                    <i class="bi bi-pencil-square"></i>

                                </a>

                                <a asp-action="Delete"
                                   asp-route-id="@item.Id"
                                   class="btn btn-danger btn-sm">

                                    <i class="bi bi-trash"></i>

                                </a>

                            </td>

                        </tr>

                        sr++;
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>