@model IEnumerable<SchoolAchievement>

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h3 class="fw-bold mb-1">School Achievements</h3>
        <p class="text-muted mb-0">
            Manage your school's achievements and awards
        </p>
    </div>

    <a asp-action="Create" class="btn btn-success">
        <i class="bi bi-plus-circle me-1"></i>
        Add Achievement
    </a>

</div>

<div class="card shadow-sm border-0">

    <div class="card-body">

        @if (Model.Any())
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>Date</th>
                            <th>Title</th>
                            <th>Description</th>
                            <th width="180">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @{
                            int sr = 1;
                        }

                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>@sr</td>

                                <td>
                                    @item.SchoolAchievementDate.ToString("dd MMM yyyy")
                                </td>

                                <td>
                                    <strong>@item.Title</strong>
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(item.Desc)
                                        ? "N/A"
                                        : item.Desc)
                                </td>

                                <td>

                                    <a asp-action="Edit"
                                       asp-route-id="@item.Id"
                                       class="btn btn-warning btn-sm me-1">

                                        <i class="bi bi-pencil-square"></i>

                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@item.Id"
                                       class="btn btn-danger btn-sm">

                                        <i class="bi bi-trash"></i>

                                    </a>

                                </td>

                            </tr>

                            sr++;
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="text-center py-5">

                <h5 class="text-muted">
                    No achievements found
                </h5>

            </div>
        }

    </div>

</div>