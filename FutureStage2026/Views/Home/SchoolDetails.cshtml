@model School

<div class="container mt-4">

    <div class="card shadow-lg p-4">

        @if (!string.IsNullOrEmpty(Model.ImagePath))
        {
            <img src="@Model.ImagePath" class="img-fluid mb-3" />
        }

        <h2 class="mb-3">@Model.Name</h2>

        @if (ViewBag.AvgRating > 0)
        {
            <p>
                <strong>Rating:</strong>

                @{
                    int fullStars = (int)Math.Floor((double)ViewBag.AvgRating);
                }

                @for (int i = 0; i < fullStars; i++)
                {
                    <span style="color: gold;">★</span>
                }

                @for (int i = fullStars; i < 5; i++)
                {
                    <span style="color: lightgray;">★</span>
                }

                (@ViewBag.AvgRating.ToString("0.0"))
            </p>
        }

        <hr />

        <div class="row">

            <div class="col-md-6">
                <p><strong>Email:</strong> @Model.EmailId</p>
                <p><strong>Contact:</strong> @Model.ContactNo</p>
                <p><strong>Established:</strong> @Model.EstablishmentDate.ToShortDateString()</p>
                <p><strong>Board:</strong>@Model.EducationBoard?.EducationBoardTitle</p>
                <p><strong>Medium</strong>@Model.Medium?.MediumTitle</p>
            </div>

            <div class="col-md-6">
                <p><strong>Address:</strong> @Model.Address</p>
                <p><strong>Area:</strong> @Model.Area?.AreaName</p>
                <p><strong>City:</strong> @Model.Area?.City?.CityName</p>
                <p><strong>State:</strong> @Model.Area?.City?.State?.StateName</p>
                <p><strong>Country:</strong> @Model.Area?.City?.State?.Country?.CountryName</p>
            </div>

            <h5>Facilities</h5>

            @if (Model.SchoolFacilities != null && Model.SchoolFacilities.Any())
            {
                <ul>
                    @foreach (var sf in Model.SchoolFacilities)
                    {
                        <li>@sf.Facility.FacilityTitle</li>
                    }
                </ul>
            }
            else
            {
                <p>No facilities listed</p>
            }

            <h4>Fees Structure</h4>

            @foreach (var ss in Model.SchoolStandards)
            {
                <h5>@ss.Standard.StandardTitle</h5>

                if (ss.StandardFees != null && ss.StandardFees.Any())
                {
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Fee Type</th>
                                <th>Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var fee in ss.StandardFees)
                            {
                                <tr>
                                    <td>@fee.FeeHead.FeeHeadTitle</td>
                                    <td>₹ @fee.Amount</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p>No fees added</p>
                }
            }

        </div>

    </div>

    <hr />

    <h4>Add Review</h4>

    <form asp-action="AddReview" method="post">

        <input type="hidden" name="SchoolId" value="@Model.Id" />

        <div class="mb-2">
            <input type="text" name="UserName" class="form-control" placeholder="Your Name" required />
        </div>

        <div class="mb-2">
            <select name="Rating" class="form-control">
                <option value="5">⭐⭐⭐⭐⭐</option>
                <option value="4">⭐⭐⭐⭐</option>
                <option value="3">⭐⭐⭐</option>
                <option value="2">⭐⭐</option>
                <option value="1">⭐</option>
            </select>
        </div>

        <div class="mb-2">
            <textarea name="Comment" class="form-control" placeholder="Write your review"></textarea>
        </div>

        <button class="btn btn-success">Submit Review</button>

    </form>

    <hr />

    <h4>Reviews</h4>

    @if (Model.Reviews != null && Model.Reviews.Any())
    {
        foreach (var r in Model.Reviews)
        {
            <div class="card mb-2 p-2">
                <strong>@r.UserName</strong> - ⭐ @r.Rating
                <p>@r.Comment</p>
            </div>
        }
    }
    else
    {
        <p>No reviews yet</p>
    }
    <hr />

    <a asp-controller="Enquiry" asp-action="Create" asp-route-schoolId="@Model.Id"
       class="btn btn-primary">
        Apply Now
    </a>

</div>

