@model List<FutureStage2026.Models.School>

<div class="row">

    @foreach (var school in Model)
    {
        <div class="col-md-4 mb-4">

            <div class="card shadow p-3">

                <h5>@school.Name</h5>

                <p>@school.Address</p>

                <a asp-action="SchoolDetails"
                   asp-route-id="@school.Id"
                   class="btn btn-primary">
                    View Details
                </a>

            </div>

        </div>
    }

</div>