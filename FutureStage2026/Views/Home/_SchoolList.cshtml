@model List<FutureStage2026.Models.School>

<div class="row">

    @if (!Model.Any())
    {
        <div class="text-center">
            <h5>No schools found 😔</h5>
        </div>
    }

    @foreach (var school in Model)
    {
        <div class="col-md-4 mb-4">

           

            <div class="card shadow-lg border-0 h-100 school-card">

                @if (!string.IsNullOrEmpty(school.ImagePath))
                {
                    <img src="@school.ImagePath" class="card-img-top" style="height:200px; object-fit:cover;" />
                }
                else
                {
                    <img src="/Frontend/Images/default-school.jpg" class="card-img-top" style="height:200px; object-fit:cover;" />
                }

                <div class="card-body">

                    <h5 class="card-title text-primary">
                        @school.Name
                    </h5>

                    <p class="mb-1">
                        📍 @school.Area?.AreaName
                    </p>

                    <p class="text-muted small">
                        @school.Address
                    </p>

                </div>

                <div class="card-footer bg-white border-0">

                    <a asp-action="SchoolDetails"
                       asp-route-id="@school.Id"
                       class="btn btn-outline-primary w-100">
                        View Details →
                    </a>

                </div>

            </div>

        </div>
    }

</div>